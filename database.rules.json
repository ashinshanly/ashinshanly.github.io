{
  "rules": {
    "games": {
      "$gameId": {
        ".read": true,
        ".write": true,
        "board": {
          ".validate": "newData.isString()"
        },
        "currentTurn": {
          ".validate": "newData.val() === 'white' || newData.val() === 'black'"
        },
        "gameStatus": {
          ".validate": "newData.val() === 'active' || newData.val() === 'checkmate' || newData.val() === 'check'"
        },
        "viewers": {
          "$sessionId": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "coding_game": {
      "leaderboard": {
        ".read": true,
        ".write": true
      }
    },
    "site_stats": {
      ".read": true,
      "total_visitors": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
      },
      "live_viewers": {
        "$sessionId": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.hasChildren(['timestamp', 'isLive']) && newData.child('timestamp').isNumber() && newData.child('isLive').isBoolean())"
        }
      }
    },
    "chainreaction": {
      ".read": true,
      ".write": true
    },
    "maze_scores": {
      ".read": true,
      ".write": true,
      ".indexOn": ["moves"],
      "$scoreId": {
        ".validate": "newData.hasChildren(['name', 'moves', 'time', 'timestamp']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('moves').isNumber() && newData.child('time').isNumber() && newData.child('timestamp').isNumber()"
      }
    },
    "pixel_hud": {
      "grid": {
        ".read": true,
        ".write": true,
        "$cellKey": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
        }
      },
      "transmissions": {
        ".read": true,
        ".write": true,
        "$txId": {
          ".validate": "newData.hasChildren(['handle', 'text', 'timestamp']) && newData.child('handle').isString() && newData.child('handle').val().length <= 32 && newData.child('text').isString() && newData.child('text').val().length <= 160 && newData.child('timestamp').isNumber()"
        }
      }
    }
  }
}
